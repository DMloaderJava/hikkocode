# ============================================================
# Frontend (Vite) — required, exposed to the browser bundle
# ============================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ============================================================
# Supabase Edge Functions secrets (NEVER put these in .env of the frontend)
# Set them with:
#   supabase secrets set LOVABLE_API_KEY=... GEMINI_API_KEYS=... GITHUB_PAT=...
# ------------------------------------------------------------
# LOVABLE_API_KEY  — AI gateway key used by functions/plan and functions/agent
#                    (model google/gemini-3.1-pro-preview)
# GEMINI_API_KEYS  — comma-separated Google Gemini API keys used by
#                    functions/chat and functions/generate (gemini-2.5-flash);
#                    multiple keys are rotated to spread quota
# GITHUB_PAT       — GitHub personal access token (repo scope) used by
#                    functions/github and by the agent to open pull requests
# ------------------------------------------------------------
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into edge functions by the platform — do not set them manually.
# ============================================================
